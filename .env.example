# Public site URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only — never expose. Used for storage uploads and the admin bootstrap.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection used by server code (Settings → Database → Connection string).
# On Vercel use the transaction pooler (port 6543).
DATABASE_URL=

# Google Gemini (server only) — chat assistant, photo search, voice search fallback
GEMINI_API_KEY=

# Ads tracking (optional) — normally set in Admin → Settings → Ads tracking.
# Pixel IDs here override the admin setting and must be set before `next build`.
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
# Server only — Conversions API / Events API tokens
META_CAPI_ACCESS_TOKEN=
TIKTOK_EVENTS_ACCESS_TOKEN=
# Testing only — remove before going live
META_TEST_EVENT_CODE=
TIKTOK_TEST_EVENT_CODE=

# Initial admin bootstrap only (npm run admin:bootstrap). Remove ADMIN_PASS afterwards.
ADMIN_EMAIL=
ADMIN_PASS=

# Secret used to sign order-access and chat tokens (32+ random chars)
APP_SECRET=

# Sandbox courier (books nothing real). Always on in development; set to 1 to allow it in production builds for staging.
ALLOW_SANDBOX_COURIER=

# Optional courier integrations — leave empty to keep them disabled
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
STEADFAST_WEBHOOK_TOKEN=
PATHAO_BASE_URL=https://api-hermes.pathao.com
PATHAO_CLIENT_ID=
PATHAO_CLIENT_SECRET=
PATHAO_USERNAME=
PATHAO_PASSWORD=
PATHAO_STORE_ID=
PATHAO_WEBHOOK_SECRET=
REDX_BASE_URL=https://openapi.redx.com.bd/v1.0.0-beta
REDX_API_TOKEN=
REDX_WEBHOOK_TOKEN=
